{
  "name": "@qr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "typecheck": "tsc -b --pretty false",
    "test": "tsx --conditions=development --import ./test/setup.ts --test test/**/*.test.ts",
    "test:compiled": "tsc -p tsconfig.test.json --pretty false && node --conditions=development --import ./.test-dist/test/setup.js --test .test-dist/test/*.test.js",
    "seed": "tsx --conditions=development src/scripts/seed.ts",
    "backup": "tsx --conditions=development src/scripts/backup.ts",
    "restore": "tsx --conditions=development src/scripts/restore.ts",
    "migrate:institution-config": "tsx --conditions=development src/scripts/migrate-institution-configuration.ts",
    "migrate:class-reminders": "tsx --conditions=development src/scripts/migrate-class-reminders.ts",
    "migrate:announcements": "tsx --conditions=development src/scripts/migrate-announcements.ts",
    "migrate:events": "tsx --conditions=development src/scripts/migrate-events.ts",
    "repair:profile-hierarchy": "tsx --conditions=development src/scripts/repair-profile-hierarchy.ts"
  },
  "dependencies": {
    "@qr/shared": "*",
    "@qr/types": "*",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.3",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.17.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.12",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
